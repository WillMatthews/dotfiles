// Waybar config — bottom bar, Aged Brass palette (see ~/Documents/THEMES.md)
// Pairs with style.css in this directory.
//
// All Nerd Font icons are written as JSON \uXXXX escapes (BMP only) so they
// survive editor / tool round-trips that strip Private Use Area characters.
// Two Pango spans per module string:
//   <span size='x-large'>...</span>   — enlarges the glyph (~1.5x).
//   <span rise='2000'>...</span>      — raises the small text by ~2pt so its
//                                       centre aligns with the icon's centre.
//                                       Pango "rise" is in 1024ths of a point.
// Bump `rise` if text reads low, lower it if it floats high.
{
    "layer": "top",
    "reload_style_on_change": true,
    "position": "bottom",
    "height": 40,
    "spacing": 6,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 10,
    "margin-right": 10,
    "expand-center": true,


    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "tray",
        "custom/claude",
        "custom/cpu",
        "custom/gpu",
        "custom/memory",
        "network",
        "bluetooth",
        "pulseaudio",
        "custom/mic",
        "backlight",
        "battery",
        "image#caffeine",
        "clock"
    ],

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "<span size='x-large'></span>  <span rise='2000'>{}</span>",
        "tooltip": false
    },

    "sway/window": {
        "format": "{title}",
        "max-length": 80,
        "tooltip": false,
        "on-scroll-up":   "swaymsg workspace prev_on_output",
        "on-scroll-down": "swaymsg workspace next_on_output"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    },

    // Claude usage — two stacked bars driven by ccusage (see
    // scripts/claude-usage.sh). No icon glyph; "S"/"W" row labels identify it.
    // Not clickable by design — hover for the full breakdown tooltip.
    "custom/claude": {
        "exec": "~/.config/waybar/scripts/claude-usage.sh",
        "return-type": "json",
        "interval": 300,
        "format": "{}"
    },

    // Caffeine — one button, three states (image module; icons in scripts/).
    //   moon  -> off (screen idles, lid suspends)
    //   lock  -> caffeine (screen kept awake: swayidle paused)
    //   C9H13N molecule -> amphetamine (awake AND lid-close won't suspend)
    // Left-click cycles; right-click forces off. Refresh via SIGRTMIN+8.
    "image#caffeine": {
        "exec": "~/.config/waybar/scripts/caffeine.sh icon",
        "size": 22,
        "interval": 3600,
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/caffeine.sh cycle",
        "on-click-right": "~/.config/waybar/scripts/caffeine.sh off"
    },

    // CPU — two stacked rows (usage % over 1-min load). See scripts/cpu.sh.
    // Values stay plain; the pill ramps (.warning) / blinks (.critical) like the
    // built-in module it replaces.
    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "on-click": "kitty -e btop"
    },

    "network": {
        "format-wifi":         "<span size='x-large'></span>",
        "format-ethernet":     "<span size='x-large'>󰈀</span>",
        "format-linked":       "<span size='x-large'>󰈀</span>",
        "format-disconnected": "<span size='x-large'></span>",
        "tooltip-format-wifi":     "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "on-click": "kitty -e nmtui"
    },

    "bluetooth": {
        "format":           "<span size='x-large'></span>",
        "format-disabled":  "<span size='x-large'></span>",
        "format-off":       "<span size='x-large'></span>",
        "format-connected": "<span size='x-large'></span>  <span rise='2000'>{num_connections}</span>",
        "tooltip-format": "{controller_alias}\n{status}",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format":           "<span size='x-large'>{icon}</span>  <span rise='2000'>{volume:>3}%</span>",
        "format-muted":     "<span size='x-large'></span>  <span rise='2000'>muted</span>",
        "format-bluetooth": "<span size='x-large'>{icon}</span>  <span rise='2000'>{volume:>3}%</span>",
        "format-icons": {
            "headphone": "",
            "headset":   "",
            "default":   ["", "", ""]
        },
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "<span size='x-large'>{icon}</span>  <span rise='2000'>{percent:>3}%</span>",
        "format-icons": ["", "", ""],
        "on-scroll-up":   "brightnessctl -d intel_backlight set +5%",
        "on-scroll-down": "brightnessctl -d intel_backlight set 5%-",
        "tooltip-format": "Brightness: {percent}%"
    },

    "battery": {
        "bat": "BAT0",
        "full-at": 95,
        "on-click": "kitty -e sh -c 'upower -i $(upower -e | grep -m1 BAT); read -rn1'",
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format":          "<span size='x-large'>{icon}</span>  <span rise='2000'>{capacity:>3}%</span>",
        "format-charging": "<span size='x-large'></span>  <span rise='2000'>{capacity:>3}%</span>",
        "format-plugged":  "<span size='x-large'></span>  <span rise='2000'>{capacity:>3}%</span>",
        "format-icons":    ["", "", "", "", ""],
        "tooltip-format":  "{timeTo}\n{power} W"
    },

    // GPU (NVIDIA) — stacked bars: utilisation % over VRAM %. See scripts/gpu.sh.
    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "on-click": "kitty -e btop"
    },

    // Temperatures — stacked bars: CPU package °C over GPU °C. scripts/temps.sh.
    "custom/temps": {
        "exec": "~/.config/waybar/scripts/temps.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "on-click": "kitty -e btop"
    },

    // Memory — stacked bars: RAM used % over swap used %. Replaces the built-in
    // `memory` pill so swap pressure (tight on this 30GB box) stays visible.
    "custom/memory": {
        "exec": "~/.config/waybar/scripts/memory.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "on-click": "kitty -e btop"
    },

    // Tailscale VPN — shield icon coloured by backend state. scripts/vpn.sh.
    "custom/vpn": {
        "exec": "~/.config/waybar/scripts/vpn.sh",
        "return-type": "json",
        "interval": 10,
        "format": "{}",
        "on-click": "kitty -e watch -n2 tailscale status"
    },

    // APT updates — count via apt-check, cached/shared across bars. scripts/updates.sh.
    "custom/updates": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "return-type": "json",
        "interval": 1800,
        "format": "{}",
        "on-click": "kitty -e sh -c 'apt list --upgradable 2>/dev/null | less'"
    },

    // Notifications DND (dunst) — click toggles. scripts/dnd.sh + SIGRTMIN+9.
    "custom/dnd": {
        "exec": "~/.config/waybar/scripts/dnd.sh",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "format": "{}",
        "on-click": "~/.config/waybar/scripts/dnd.sh toggle"
    },

    // Microphone (default source) — click mutes/unmutes. scripts/mic.sh + SIGRTMIN+10.
    "custom/mic": {
        "exec": "~/.config/waybar/scripts/mic.sh",
        "return-type": "json",
        "interval": 30,
        "signal": 10,
        "format": "{}",
        "on-click": "~/.config/waybar/scripts/mic.sh toggle"
    },

    // Power profile — click cycles performance / balanced / power-saver.
    "power-profiles-daemon": {
        "format": "<span size='x-large'>{icon}</span>",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "format-icons": {
            "default":     "",
            "performance": "",
            "balanced":    "",
            "power-saver": ""
        }
    },

    "clock": {
        "interval": 1,
        "format":     "<span size='x-large'></span>  <span rise='2000'>{:%a %d %b   %H:%M}</span>",
        "format-alt": "<span size='x-large'></span>  <span rise='2000'>{:%Y-%m-%d  %H:%M:%S}</span>",
        "tooltip-format": "<tt><span size='large'>{calendar}</span></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#FFC332'><b>{}</b></span>",
                "days":     "<span color='#EFE3CE'>{}</span>",
                "weeks":    "<span color='#A89880'>W{}</span>",
                "weekdays": "<span color='#D6A12A'><b>{}</b></span>",
                "today":    "<span color='#FFC332'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up":   "shift_up",
            "on-scroll-down": "shift_down"
        }
    }
}
