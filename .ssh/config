Host jetson
	User root

Host jetson-agent
	User agent

Host jetson jetson-agent
	HostName 10.3.5.81
	IdentityFile ~/.ssh/id_ed25519

Host camera
	SetEnv TERM=xterm
	HostName 172.16.1.2
	User root

# Most remote machines lack Kitty's terminfo. Use a widely supported
# terminal for SSH from Kitty, while keeping host-specific settings above.
Match exec "test \"$TERM\" = xterm-kitty"
	SetEnv TERM=xterm-256color
